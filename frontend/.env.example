# ============================================================
# FRONTEND ENVIRONMENT VARIABLES — LILLO
# Copy this file to .env.local and fill in your actual values.
# NEVER commit .env.local to version control.
# ============================================================

# --- Backend API URL ---
# Development: points to local Express backend
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- WhatsApp Business ---
# Your WhatsApp Business number in international format (no + or spaces)
# Example: 6281234567890 (Indonesia +62 prefix)
NEXT_PUBLIC_WHATSAPP_BUSINESS_NUMBER=

# ============================================================
# VERCEL DEPLOYMENT — Environment Variables to set in Dashboard
# Dashboard → Project → Settings → Environment Variables
# ============================================================
# NEXT_PUBLIC_API_URL=https://your-backend.vercel.app
# NEXT_PUBLIC_WHATSAPP_BUSINESS_NUMBER=628xxxxxxxxxx
#
# ⚠️  NEVER add Appwrite keys or any backend secrets to this file.
# ⚠️  NEVER add NEXT_PUBLIC_APPWRITE_API_KEY or similar.
# Frontend communicates with Appwrite exclusively via the Express backend.
