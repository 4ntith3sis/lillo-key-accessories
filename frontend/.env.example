# ============================================================
# FRONTEND ENVIRONMENT VARIABLES — LILLO
# Copy file ini ke: frontend/.env.local
# Isi nilainya. JANGAN commit .env.local ke repository.
# ============================================================

# URL Express backend API
# Development: http://localhost:4000
# Production: isi dengan URL backend Vercel Anda
NEXT_PUBLIC_API_URL=http://localhost:4000

# Nomor WhatsApp Business (format internasional, tanpa + atau spasi)
# Contoh Indonesia: 6281234567890
NEXT_PUBLIC_WHATSAPP_BUSINESS_NUMBER=
