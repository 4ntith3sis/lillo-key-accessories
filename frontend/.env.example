# Frontend Configuration
# Development (local)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WHATSAPP_BUSINESS_NUMBER=6281234567890

# Note: Appwrite integration is managed via backend Express API (/backend/.env)
# APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
# APPWRITE_PROJECT_ID=lillo-accessories
# APPWRITE_DATABASE_ID=lillo_main_db

# =============================================================
# VERCEL DEPLOYMENT — set these in Vercel Dashboard > Project
# Settings > Environment Variables (Production environment only)
# =============================================================
# NEXT_PUBLIC_API_URL=https://your-backend.vercel.app
# NEXT_PUBLIC_WHATSAPP_BUSINESS_NUMBER=6281234567890
#
# NEXT_PUBLIC_API_URL should point to your deployed backend service URL.
# Never put Appwrite keys or secrets in NEXT_PUBLIC_* variables.
