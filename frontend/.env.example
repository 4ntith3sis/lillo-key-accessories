# ============================================================
# FRONTEND ENVIRONMENT VARIABLES — LILLO
# Copy file ini ke: frontend/.env.local
# Isi nilainya. JANGAN commit .env.local ke repository.
# ============================================================

# URL Express backend API.
# Arsitektur target: frontend lokal (localhost:3000) TIDAK membutuhkan
# backend lokal — seluruh /api/* di-handle Vercel Serverless (Express).
# Development: https://lillo-key-accessories.vercel.app
# (Alternatif: jalankan backend lokal `cd backend && npm run dev`,
#  lalu set NEXT_PUBLIC_API_URL=http://localhost:4000)
NEXT_PUBLIC_API_URL=https://lillo-key-accessories.vercel.app

# Nomor WhatsApp Business (format internasional, tanpa + atau spasi)
# Contoh Indonesia: 6281234567890
NEXT_PUBLIC_WHATSAPP_BUSINESS_NUMBER=
