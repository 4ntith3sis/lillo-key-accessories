# ============================================================
# BACKEND ENVIRONMENT VARIABLES — LILLO
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ============================================================

# --- Server ---
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# --- Appwrite Configuration ---
# Get these values from your Appwrite Console
APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=

# --- Appwrite Collection IDs ---
APPWRITE_PRODUCTS_TABLE_ID=
APPWRITE_CATEGORIES_TABLE_ID=
APPWRITE_INVENTORY_TABLE_ID=
APPWRITE_INVENTORY_TRANSACTIONS_TABLE_ID=
APPWRITE_HOMEPAGE_CONTENT_TABLE_ID=
APPWRITE_ABOUT_CONTENT_TABLE_ID=

# --- Appwrite Storage Bucket IDs ---
APPWRITE_PRODUCT_IMAGES_BUCKET_ID=
APPWRITE_HOMEPAGE_ASSETS_BUCKET_ID=

# --- Admin (dev fallback only) ---
# Production: use Appwrite user labels ('admin') for authorization.
# Dev only: used as fallback when Appwrite is unreachable locally.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Session Cookie Overrides (optional) ---
# Production defaults: SameSite=None, Secure=true (for cross-site auth)
# Development defaults: SameSite=Lax, Secure=false
# COOKIE_SAMESITE=none
# COOKIE_SECURE=true

# ============================================================
# VERCEL DEPLOYMENT — Environment Variables to set in Dashboard
# Dashboard → Project → Settings → Environment Variables
# ============================================================
# NODE_ENV=production
# FRONTEND_URL=https://your-frontend.vercel.app
# APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
# APPWRITE_PROJECT_ID=<your-project-id>
# APPWRITE_API_KEY=<your-server-api-key>          ← SECRET
# APPWRITE_DATABASE_ID=<your-database-id>
# APPWRITE_PRODUCTS_TABLE_ID=<collection-id>
# APPWRITE_CATEGORIES_TABLE_ID=<collection-id>
# APPWRITE_INVENTORY_TABLE_ID=<collection-id>
# APPWRITE_INVENTORY_TRANSACTIONS_TABLE_ID=<collection-id>
# APPWRITE_HOMEPAGE_CONTENT_TABLE_ID=<collection-id>
# APPWRITE_ABOUT_CONTENT_TABLE_ID=<collection-id>
# APPWRITE_PRODUCT_IMAGES_BUCKET_ID=<bucket-id>
# APPWRITE_HOMEPAGE_ASSETS_BUCKET_ID=<bucket-id>
# ADMIN_EMAIL=admin@yourdomain.com
