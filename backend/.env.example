PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=PASTE_YOUR_APPWRITE_PROJECT_ID_HERE
APPWRITE_API_KEY=PASTE_YOUR_APPWRITE_API_KEY_HERE
APPWRITE_DATABASE_ID=lillo_main_db

APPWRITE_PRODUCTS_TABLE_ID=PASTE_PRODUCTS_TABLE_ID_HERE
APPWRITE_CATEGORIES_TABLE_ID=PASTE_CATEGORIES_TABLE_ID_HERE
APPWRITE_INVENTORY_TABLE_ID=inventory
APPWRITE_HOMEPAGE_CONTENT_TABLE_ID=homepage_content

APPWRITE_PRODUCT_IMAGES_BUCKET_ID=PASTE_PRODUCT_IMAGES_BUCKET_ID_HERE
APPWRITE_HOMEPAGE_ASSETS_BUCKET_ID=PASTE_HOMEPAGE_ASSETS_BUCKET_ID_HERE

# Admin authorization: Appwrite user with the `admin` label, or this email,
# is granted admin access. Never commit real credentials.
ADMIN_EMAIL=admin@lillo.com
# Dev fallback login only (used when Appwrite is unreachable). Set a strong
# value locally; leave unset in production.
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Session cookie overrides (defaults: SameSite=Lax + insecure in dev,
# SameSite=None + Secure in production for cross-site frontend → API auth).
# COOKIE_SAMESITE=lax
# COOKIE_SECURE=false

# =============================================================
# VERCEL DEPLOYMENT — set these in Vercel Dashboard > Project
# Settings > Environment Variables (do NOT commit real values)
# =============================================================
# NODE_ENV=production
# PORT=                          # Vercel assigns this automatically
# FRONTEND_URL=https://your-frontend.vercel.app
# APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
# APPWRITE_PROJECT_ID=...
# APPWRITE_API_KEY=...
# APPWRITE_DATABASE_ID=lillo_main_db
# APPWRITE_PRODUCTS_TABLE_ID=...
# APPWRITE_CATEGORIES_TABLE_ID=...
# APPWRITE_INVENTORY_TABLE_ID=inventory
# APPWRITE_HOMEPAGE_CONTENT_TABLE_ID=homepage_content
# APPWRITE_ABOUT_CONTENT_TABLE_ID=about_content
# APPWRITE_PRODUCT_IMAGES_BUCKET_ID=...
# APPWRITE_HOMEPAGE_ASSETS_BUCKET_ID=...
# ADMIN_EMAIL=admin@yourdomain.com
