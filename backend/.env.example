# ============================================================
# BACKEND ENVIRONMENT VARIABLES — LILLO
# Copy file ini ke: backend/.env
# Isi nilainya. JANGAN commit .env ke repository.
# ============================================================

# Server
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Appwrite — dapatkan dari Appwrite Console
APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=

# Appwrite Collection IDs
APPWRITE_PRODUCTS_TABLE_ID=
APPWRITE_CATEGORIES_TABLE_ID=
APPWRITE_INVENTORY_TABLE_ID=
APPWRITE_INVENTORY_TRANSACTIONS_TABLE_ID=
APPWRITE_HOMEPAGE_CONTENT_TABLE_ID=
APPWRITE_ABOUT_CONTENT_TABLE_ID=
APPWRITE_ADMIN_SESSIONS_TABLE_ID=

# Appwrite Storage Bucket IDs
APPWRITE_PRODUCT_IMAGES_BUCKET_ID=
APPWRITE_HOMEPAGE_ASSETS_BUCKET_ID=

# Session signing secret — BACKEND-ONLY, never expose to the frontend.
# Generate with:  openssl rand -hex 32
# If unset, admin auth fails safely (no tokens issued or accepted).
SESSION_SECRET=

# Admin (dev fallback — production wajib gunakan Appwrite user label 'admin')
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Session Cookie (opsional — default sudah aman)
# COOKIE_SAMESITE=none
# COOKIE_SECURE=true
