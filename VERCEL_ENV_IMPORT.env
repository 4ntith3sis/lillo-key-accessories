# --- APPWRITE STORAGE BUCKETS ---
APPWRITE_PRODUCT_IMAGES_BUCKET_ID=product-images
APPWRITE_HOMEPAGE_ASSETS_BUCKET_ID=product-images

# --- SESSION AUTH (backend-only) ---
# WAIIBU diisi di dashboard: generate nilai (64+ char, mis. `openssl rand -hex 32`).
# Tanpa SESSION_SECRET, admin login/verify fail-safe (HTTP 503), tidak ada fallback secret.
SESSION_SECRET=<generate-with-openssl-rand-hex-32>

# --- FRONTEND CLIENT ---
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_WHATSAPP_BUSINESS_NUMBER=6281234567890
