# --- SERVER & CORS ---
NODE_ENV=production
FRONTEND_URL=https://lillo-key-accessories.vercel.app

# --- APPWRITE CORE ---
APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=6aa8c9050018359cec8e
APPWRITE_DATABASE_ID=6aa90b1a000fdda46362
APPWRITE_API_KEY=standard_a97cea9a43cd3a534bd8c85bcf8f922d6db96df4061bc5d50d2e35116748ec37498ca8a31f40de17ecffbe172d133bb8ed9f10745423222afd3bdcd5b46b11a600c33c5bedbcbee1a868cf0f578bcb3b37bb5e9bec648fca2a22c68b82dfdc0f7155785efe6228f232047e441b2e248b9077e29d23c3c4af8d85711a716d2ab3

# --- APPWRITE COLLECTIONS / TABLES ---
APPWRITE_PRODUCTS_TABLE_ID=products
APPWRITE_CATEGORIES_TABLE_ID=categories
APPWRITE_INVENTORY_TABLE_ID=inventory
APPWRITE_INVENTORY_TRANSACTIONS_TABLE_ID=inventory_transactions
APPWRITE_HOMEPAGE_CONTENT_TABLE_ID=homepage_content
